# PathBack — environment template
# Copy to .env and fill in. Never commit .env.

# ── Inference lanes ─────────────────────────────────────────────
# Groq (free tier — this is the main free-tier lane). Get a key at
# https://console.groq.com → API Keys → Create API Key.
GROQ_API_KEY=

# Anthropic (paid-tier lane only; free users never touch it)
ANTHROPIC_API_KEY=

# Local Ollama lane (optional backup; defaults shown)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Routing overrides (defaults shown; lanes: groq, local, claude)
# PATHBACK_FREE_CHAIN=groq,local
# PATHBACK_PAID_CHAIN=claude,groq
# PATHBACK_VERIFY_CHAIN=groq,local

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_ID_PASS_7DAY=
PRICE_ID_SUB_MONTHLY=
PRICE_ID_SUB_YEARLY=

# Public URL used in Stripe success/cancel redirects
# (your Cloudflare Tunnel hostname)
PUBLIC_BASE_URL=https://pathback.example.com

# ── Admin ───────────────────────────────────────────────────────
GUARD_ADMIN_KEY=change-me
GUARD_ADMIN_PASSWORD=change-me
# Comma-separated legacy tokens (optional; SQLite admin_tokens preferred)
ADMIN_TOKENS=

# ── Storage ─────────────────────────────────────────────────────
# PATHBACK_DB=/data/pathback.db
